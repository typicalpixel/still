#!/bin/sh

# Erlang distribution configuration.
#
# Still's controller and agent processes talk over Erlang distribution, so
# the release must start with a named node. `STILL_NODE_HOST` tells Erlang
# what host to advertise (usually the machine's routable IP or hostname).
# Defaults to 127.0.0.1 for single-host / testing setups; override in
# /etc/still/still.env for real multi-host deployments.

# Source the installed env file so manual invocations of `still
# remote`/`rpc`/`eval` see the same STILL_NODE_HOST, DATABASE_PATH, etc.
# as the running service. systemd applies the EnvironmentFile already;
# this just covers the case where an operator runs bin/still directly.
: "${STILL_ETC:=/etc/still}"

set -a
if [ -f "$STILL_ETC/still.env" ]; then
  . "$STILL_ETC/still.env"
fi
if [ -f "$STILL_ETC/still.env.local" ]; then
  . "$STILL_ETC/still.env.local"
fi
set +a

export RELEASE_DISTRIBUTION=name
export RELEASE_NODE=<%= @release.name %>@${STILL_NODE_HOST:-127.0.0.1}
